# Mercury Dockerfile for testing examples
FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    wget \
    gcc \
    make \
    && rm -rf /var/lib/apt/lists/*

# Install Mercury compiler
WORKDIR /tmp
RUN wget -q https://github.com/Mercury-Language/mercury/releases/download/v23.01.1/mercury-23.01.1-linux-x86_64.tar.gz \
    && tar -xzf mercury-23.01.1-linux-x86_64.tar.gz \
    && cd mercury-23.01.1-linux-x86_64 \
    && ./configure --prefix=/usr/local \
    && make install \
    && cd .. \
    && rm -rf mercury-23.01.1-linux-x86_64*

# Clean up
RUN apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the Mercury example files
COPY jeff/subprograms/ ./subprograms/
COPY jeff/data_types_or_binding/ ./data_types_or_binding/
COPY jeff/control_structures/ ./control_structures/

# Set working directory to jeff for tests
WORKDIR /app/jeff

# Default command (can be overridden)
CMD ["bash"]
